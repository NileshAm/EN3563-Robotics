<?xml version="1.0"?>
<package format="3">
  <name>control_dashboard</name>
  <version>0.0.0</version>
  <description>Simple pose control dashboard and motion service interfaces</description>
  <maintainer email="nileshamarathunge@gmail.com">nilesh</maintainer>
  <license>TODO: License declaration</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
