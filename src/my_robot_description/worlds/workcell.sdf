          <geometry><box><size>0.5 0.9 0.05</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.275 0 0 0</pose>
          <geometry><box><size>0.5 0.9 0.05</size></box></geometry>
