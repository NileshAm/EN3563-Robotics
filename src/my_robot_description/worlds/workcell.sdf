<?xml version="1.0"?>
<sdf version="1.9">
  <world name="workcell">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.55 0.58 0.6 1</ambient><diffuse>0.55 0.58 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Include the existing URDF at startup so Reset All restores it too. -->
    <include>
      <uri>model://my_robot_description/urdf/robot.urdf</uri>
      <name>my_robot</name>
      <!-- world_to_base in the URDF defines the robot's workcell mounting. -->
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Box A's model origin is its bottom centre, as requested. -->
    <model name="box_a">
      <static>true</static>
      <pose>0.5 0.5 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 0.3 0.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.2</size></box></geometry>
          <material><ambient>0.12 0.35 0.8 1</ambient><diffuse>0.12 0.35 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Reproducible reachable ground location; pose is the cube centre. -->
    <model name="box_b">
      <pose>0.45 -0.2 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.0000208333</ixx><iyy>0.0000208333</iyy><izz>0.0000208333</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.85 0.12 0.05 1</ambient><diffuse>0.85 0.12 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
