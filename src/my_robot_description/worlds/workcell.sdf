        </visual>
      </link>
    </model>

    <!-- These model poses are the reset targets. Units: metres and radians. -->
    <model name="red_cube">
      <pose>0.6 -0.25 0.34 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001066667</ixx><iyy>0.0001066667</iyy><izz>0.0001066667</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.08 0.08 0.08</size></box></geometry></collision>
